# Port the game server listens on (Render sets this automatically)
PORT=3000

# Base URL of the Mix Master Platform (no trailing slash).
# REQUIRED for score posting after each game — without this, no scores are saved.
# Set this in your Render dashboard environment variables.
PLATFORM_URL=https://mix-master-gray.vercel.app

# Shared secret between game server and platform.
# REQUIRED for score posting — requests without this header are rejected.
# Generate with: openssl rand -hex 32
# Must match GAME_API_SECRET in the platform's Vercel environment variables.
GAME_API_SECRET=your_secret_here
