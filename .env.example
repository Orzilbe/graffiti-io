# Port the game server listens on
PORT=3000

# Base URL of the Mix Master Platform (no trailing slash).
# When set, QR codes on the display all point to ${PLATFORM_URL}/hub
# so players join via the platform instead of direct controller URLs.
# Leave blank to use direct /controller/0-3 URLs instead.
PLATFORM_URL=

# Shared secret between game server and platform.
# Generate with: openssl rand -hex 32
# Must match GAME_API_SECRET in the platform's .env.local
GAME_API_SECRET=
